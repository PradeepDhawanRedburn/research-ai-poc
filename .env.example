# research_qa settings. Copy to .env and fill in. Every value is read by research_qa/config.py.

# ---------------------------------------------------------------- Store: one Blob container holds everything
# (raw Word, Markdown+, assets, facts, chunks, manifest, evaluation runs). Entra ID (az login) or a connection string.
STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=research
# ARM id of the storage account (scripts/setup_access.ps1 prints it). The Word arm's Blob knowledge source reads raw/
# with the search service's managed identity; without it, STORAGE_CONNECTION_STRING is used instead.
STORAGE_RESOURCE_ID=
# Development and tests only: a local folder instead of Blob
STORE_LOCAL_DIR=
# Where assets are copied for libraries that need a file path (default .cache under the repo)
CACHE_DIR=

# ---------------------------------------------------------------- Azure OpenAI (Foundry) deployments
# Resource endpoint, e.g. https://<name>.openai.azure.com or https://<name>.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=
# Leave empty to sign in with Entra ID (needs the "Cognitive Services OpenAI User" role)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Answers questions in both modes (agent and direct); the agent is created on this deployment
ANSWER_MODEL=gpt-5-mini
AGENT_REASONING_EFFORT=low
# Describes pictures at ingest and looks at them for inspect_figure; must accept images (default: ANSWER_MODEL)
VISION_DEPLOYMENT=
VISION_EFFORT=medium
VISION_CONCURRENCY=4
# Grades answers in `eval`; use a different, stronger deployment than ANSWER_MODEL
JUDGE_DEPLOYMENT=
# Embeddings for the Markdown+ index (the Word arm embeds inside the search service with the same deployment)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DIMENSIONS=3072
# Optional: when the embedding deployment lives in another resource
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=

# ---------------------------------------------------------------- Retrieval engine
# azure: AI Search knowledge bases + Foundry agents (the Word arm is Azure's own Blob ingestion; files above the
#        tier's size cap, 16 MB on Basic, are skipped). langchain: Chroma + LangChain on this machine, any tier
#        (the Word arm is then the stock MarkItDown conversion with no plugin). Same arms, modes, app and eval.
RETRIEVAL_BACKEND=azure
# Where the Chroma collections live with the langchain engine (derived data, rebuilt by `index`)
CHROMA_DIR=
# Retrieval quality flags (langchain engine), each recorded in every evaluation run for A/B comparison.
# Put the chunks of a figure the question names ("Fig 27") first in the results
RETRIEVAL_FIGURE_BOOST=1
# none | cohere: rerank the fused candidates with a Cohere Rerank model deployed as a Foundry serverless endpoint
RERANKER=none
RERANK_CANDIDATES=40
RERANK_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL=
# Direct mode: send the original pictures behind the top figure passages with the question (both engines);
# the agent mode has inspect_figure instead. Costs image tokens on every direct answer that retrieves a figure.
DIRECT_IMAGES=0
DIRECT_IMAGES_MAX=3

# ---------------------------------------------------------------- Azure AI Search and the Foundry project
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# Endpoint the search service uses to call the embedding model (default: <resource>.openai.azure.com from above)
AZURE_SEARCH_OPENAI_ENDPOINT=
AZURE_SEARCH_API_VERSION=2026-08-01-preview
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>/projects/<project>
# Base name of every Azure object: <base>-markdown-plus (index), <base>-ks-<arm>, <base>-kb-<arm>, <base>-agent-<arm>
BASE_NAME=research-reports
# Passages per knowledge-base retrieval, the same for both arms
MAX_DOCS=12
# Characters per Markdown+ chunk
CHUNK_CHARS=1800

# ---------------------------------------------------------------- Cost per question
# Prices per million tokens per deployment (see prices.yaml); CURRENCY labels the numbers
PRICES_FILE=
CURRENCY=GBP
