# Azure AI Foundry (Azure OpenAI API). Copy to .env and fill in.
# Endpoint of the Foundry / Azure OpenAI resource, e.g. https://<name>.openai.azure.com/ or https://<name>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=
# Leave empty to sign in with Entra ID (az login / managed identity; needs the "Cognitive Services OpenAI User" role)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (as named in Foundry, not the model names)
AZURE_CHAT_DEPLOYMENT=gpt-4.1
# Vision model for describing pictures at ingestion; defaults to the chat deployment (must accept images)
AZURE_VISION_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Grades answers in `rag eval` and `agentic eval`. Use a different (stronger) deployment than the one that answers.
JUDGE_DEPLOYMENT=
# Optional: set when the embedding deployment is in another resource
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
# Optional: shorten text-embedding-3 vectors (e.g. 1024)
AZURE_EMBEDDING_DIMENSIONS=

# Agentic retrieval (agentic/): Azure AI Search knowledge base + Foundry agent. Names follow the Learn tutorial.
# Portal: search service > Overview; Foundry project > Endpoints and Properties.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
PROJECT_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>/projects/<project>
# Deployment the agent runs on. Must be a deployment in the Foundry resource above (the tutorial uses gpt-5-mini)
AGENT_MODEL=gpt-5-mini
# Optional: endpoint the search service uses to embed queries. Default: https://<resource>.openai.azure.com derived from AZURE_OPENAI_ENDPOINT
# AZURE_SEARCH_OPENAI_ENDPOINT=
# Optional tuning: AGENT_REASONING_EFFORT=low (minimal|low|medium|high), AGENTIC_MAX_DOCS=12 (passages per knowledge base search),
# AGENTIC_VISION_DEPLOYMENT (default: AGENT_MODEL; reads figure pictures), AGENTIC_VISION_EFFORT=medium
# Optional base names (each solution adds -docx or -markdown): AZURE_SEARCH_INDEX, AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME, AZURE_SEARCH_AGENT_NAME, AGENT_NAME, PROJECT_CONNECTION_NAME

# Optional tuning
# RAG_CHUNK_CHARS=1800
# RAG_TOP_K=8
# RAG_MAX_ANSWER_IMAGES=3
# RAG_VISION_CONCURRENCY=4
